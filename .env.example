# ─────────────────────────────────────────────
# Database (PostgreSQL — self-hosted via Docker)
# ─────────────────────────────────────────────
# Used by Prisma and the web app
DATABASE_URL="postgresql://crm:your_password_here@postgres:5432/crm"

# For local development (outside Docker, pointing to localhost)
# DATABASE_URL="postgresql://crm:your_password_here@localhost:5432/crm"

# PostgreSQL password — used by docker-compose
POSTGRES_PASSWORD="change_this_strong_password"

# ─────────────────────────────────────────────
# Auth (NextAuth.js v5)
# ─────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# In production: NEXTAUTH_URL="https://your-domain.com"

# ─────────────────────────────────────────────
# Redis (for BullMQ job queues)
# ─────────────────────────────────────────────
REDIS_URL="redis://redis:6379"
# For local dev: REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# WhatsApp Engine (internal)
# ─────────────────────────────────────────────
# Secret shared between web app and whatsapp engine
# Generate: openssl rand -hex 32
INTERNAL_SECRET="change-this-to-a-random-secret"

# URL of the whatsapp engine (used by web app to call it)
WHATSAPP_ENGINE_URL="http://whatsapp:3001"
# For local dev: WHATSAPP_ENGINE_URL="http://localhost:3001"

# URL of the web app (used by whatsapp engine to post events back)
WEB_APP_URL="http://web:3000"
# For local dev: WEB_APP_URL="http://localhost:3000"

# Where session auth files are stored (inside whatsapp container)
SESSIONS_DIR="/app/whatsapp-sessions"

# ─────────────────────────────────────────────
# Google Analytics 4 (optional)
# ─────────────────────────────────────────────
# Get from GA4 Admin → Data Streams → Measurement Protocol API secrets
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
GA4_API_SECRET=""

# ─────────────────────────────────────────────
# App settings
# ─────────────────────────────────────────────
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Max file upload size (bytes) — 10MB default
MAX_UPLOAD_SIZE="10485760"
