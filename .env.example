# ─────────────────────────────────────────────
# Database (Supabase)
# ─────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → Database
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────
# Clerk Authentication
# ─────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─────────────────────────────────────────────
# Redis (for BullMQ job queues)
# ─────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ─────────────────────────────────────────────
# WhatsApp Engine (internal)
# ─────────────────────────────────────────────
# Secret shared between web app and whatsapp engine
# Generate: openssl rand -hex 32
INTERNAL_SECRET="change-this-to-a-random-secret"

# URL of the web app (used by whatsapp engine to post events)
WEB_APP_URL="http://web:3000"

# Port for whatsapp engine
WHATSAPP_ENGINE_URL="http://whatsapp:3001"

# Where session auth files are stored (inside whatsapp container)
SESSIONS_DIR="/app/whatsapp-sessions"

# ─────────────────────────────────────────────
# Google Analytics 4
# ─────────────────────────────────────────────
# Get from GA4 Admin → Data Streams → Measurement Protocol API secrets
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
GA4_API_SECRET=""

# ─────────────────────────────────────────────
# App settings
# ─────────────────────────────────────────────
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Max file upload size (bytes)
MAX_UPLOAD_SIZE="10485760"
